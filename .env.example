# ==============================================================================
# SuperCollection Work Desk - Environment Configuration
# Copy this file to .env.local and replace with your live credentials
# ==============================================================================

# Supabase Database & Auth (From your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Ping4SMS Gateway API
PING4SMS_API_KEY=your-ping4sms-api-key
PING4SMS_SENDER_ID=SUPCOL
PING4SMS_ENTITY_ID=your-dlt-entity-id
PING4SMS_TEMPLATE_ID=your-dlt-template-id

# Webhook Secrets
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-whatsapp-verify-token

# WhatsApp Chat Box Integration
WORKDESK_SYNC_SECRET=your-shared-workdesk-sync-secret
WHATSAPP_API_URL=http://localhost:3001
